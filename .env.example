# Copier ce fichier vers .env. Identifiants exclusivement fictifs.
# Encoder les caractères spéciaux des identifiants dans l'URL (%40 pour @, etc.).
DATABASE_URL="postgresql://demo:demo@127.0.0.1:55432/entity_generator_demo?sslmode=disable"
DB_SCHEMA=public
ENTITY_OUTPUT=generated/Entity
ENTITY_NAMESPACE="App\\Entity"
EXCLUDE_TABLES=doctrine_migration_versions

# API désactivée sauf présence de --api-platform.
API_OPERATIONS=Get,GetCollection
# Listes explicites table.colonne SQL (les relations ne sont pas exposées).
API_READ_FIELDS=demo_author.id,demo_author.display_name,demo_article.id,demo_article.title
API_WRITE_FIELDS=demo_author.display_name,demo_article.title
API_READ_GROUP=entity:read
API_WRITE_GROUP=entity:write
